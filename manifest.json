{
  "manifest_version": 3,
  "name": "X Interests Filter",
  "version": "0.1.0",
  "description": "Hides x.com home timeline posts that do not match your interests.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "match.js",
        "content.js"
      ],
      "css": [
        "panels.css"
      ]
    }
  ]
}
