{
  "manifest_version": 3,
  "name": "Interests Filter for X",
  "version": "0.1.0",
  "description": "Hides x.com home timeline posts that do not match your interests.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "match.js",
        "content.js"
      ],
      "css": [
        "panels.css"
      ]
    }
  ]
}
